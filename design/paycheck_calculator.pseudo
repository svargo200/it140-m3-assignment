START paycheck_calculator

    Get hours_worked

    IF hours_worked > 40 THEN
        LET regular_pay = 40 * 20
        LET overtime_hours = hours_worked - 40
        LET overtime_pay = ovetime_hours * 30
    ELSE   
        LET regular_pay = regular_hours worked * 20
        LET overtime_pay = 0
    ENDIF

    LET total_pay = regular_pay + overtime_pay

    PUT total_pay

END paycheck_calculator



